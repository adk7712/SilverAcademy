{
  "expo": {
    "name": "SilverAcademy",
    "slug": "silveracademy",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "SilverAcademy uses the camera to scan learners' QR tickets for check-in."
        }
      ]
    ]
  }
}
