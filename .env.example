# Copy to .env.local files where noted. Never commit real secrets.

# functions/.env.local (read by the Functions emulator)
AUTH_MODE=mock
QR_HMAC_SECRET=dev-only-change-me
# Set true ONLY in your local functions/.env.local for demos/e2e (bypasses the check-in window; ignored outside emulators).
DEMO_IGNORE_CHECKIN_WINDOW=false
MAP_PROVIDER=stub
# ONEMAP_TOKEN=

# apps/mobile/.env.local (Expo, EXPO_PUBLIC_ vars are bundled into the client)
EXPO_PUBLIC_USE_EMULATORS=true
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-silveracademy
EXPO_PUBLIC_EMULATOR_HOST=localhost

# apps/web/.env.local (Vite)
VITE_USE_EMULATORS=true
VITE_FIREBASE_PROJECT_ID=demo-silveracademy
VITE_EMULATOR_HOST=localhost

# Hosted demo (Vercel env vars; see docs/hosted-demo.md). Staff web: https://silver-academy-web-adk7712.vercel.app
# Mobile web: https://silver-academy-mobile-adk7712.vercel.app. The web API key is public client config.
# VITE_USE_EMULATORS=false
# VITE_FIREBASE_PROJECT_ID=silveracademy-demo-adk
# VITE_FIREBASE_API_KEY=<web API key from the Firebase console>
# EXPO_PUBLIC_USE_EMULATORS=false
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=silveracademy-demo-adk
# EXPO_PUBLIC_FIREBASE_API_KEY=<web API key from the Firebase console>
# functions/.env.silveracademy-demo-adk (git-ignored): AUTH_MODE=mock, ALLOW_MOCK_AUTH=true, QR_HMAC_SECRET=<random>, MAP_PROVIDER=stub
# Cloud seed only: SEED_CLOUD_PROJECT=silveracademy-demo-adk (must equal GCLOUD_PROJECT) plus the three secrets below.

# Seed script (firebase/seed, emulator only). Optional; defaults in firebase/seed/guard.ts. Passwords min 8 chars.
# SEED_ADMIN_PASSWORD=
# SEED_PARTNER_PASSWORD=
