{
  "firestore": {
    "rules": "firebase/firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  },
  "storage": {
    "rules": "firebase/storage.rules"
  },
  "functions": [
    {
      "source": ".deploy/functions",
      "codebase": "default",
      "predeploy": ["npm run build:functions", "node firebase/prepare-functions-deploy.mjs"]
    }
  ],
  "auth": {
    "providers": {
      "emailPassword": true
    }
  }
}
